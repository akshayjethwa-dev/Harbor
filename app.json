{
  "expo": {
    "name": "Harbor",
    "slug": "harbor",
    "scheme": "harbor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Harbor needs camera access for selfie verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Harbor needs access to your photos to set a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Harbor uses your location to find Plans near you."
        }
      ],
      "@sentry/react-native",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "bundleIdentifier": "com.harbor.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.harbor.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d13a4298-ab28-49e2-8f35-5fee1956d595"
      }
    },
    "owner": "akshay2888"
  }
}