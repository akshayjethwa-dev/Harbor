// storage.rules
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow reading all profile photos (or restrict to authenticated users)
    // Allow writing only to the owner of the folder
    match /users/{userId}/photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // Keep your existing rules for other paths (e.g., avatars, reports)
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}