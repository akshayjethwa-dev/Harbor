rules_version = '2';
service cloud.firestore {
  match /databases/{fsdb}/documents {

    // ─────────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny([
            'hostScore', 'guestScore', 'trustBalance',
            'isBanned', 'suspendedUntil', 'strikes',
            'referralCode', 'referralCount', 'referredBy', 'referredAt',
            'plansCreatedToday', 'plansCreatedThisWeek',
            'planDayStart', 'planWeekStart'
          ]);

      match /emergencyContacts/{contactId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Plans
    // ─────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || resource.data.participants.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Squads
    // ─────────────────────────────────────────────────────────
    match /squads/{squadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.adminUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.adminUid == request.auth.uid
            || resource.data.coAdminUids.hasAny([request.auth.uid])
            || (resource.data.memberUids.hasAny([request.auth.uid])
                && request.resource.data.memberUids.hasAny([request.auth.uid])));
      allow delete: if false;

      match /memberLogs/{logId} {
        allow read: if request.auth != null
          && resource.data.targetUid == request.auth.uid;
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Plan Templates
    // ─────────────────────────────────────────────────────────
    match /planTemplates/{templateId} {
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // Invitations
    // ─────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow create: if request.auth != null
        && request.resource.data.inviterUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.invitedUid == request.auth.uid
            || resource.data.inviterUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.invitedUid == request.auth.uid
        && request.resource.data.status in ["accepted", "declined"];
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partner Swipes
    // ─────────────────────────────────────────────────────────
    match /partnerSwipes/{swipeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partner Matches
    // ─────────────────────────────────────────────────────────
    match /partnerMatches/{matchId} {
      allow read: if request.auth != null
        && resource.data.users.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.users.hasAny([request.auth.uid]);
      allow update: if request.auth != null
        && resource.data.users.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(fsdb)/documents/partnerMatches/$(matchId)).data.users.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && get(/databases/$(fsdb)/documents/partnerMatches/$(matchId)).data.users.hasAny([request.auth.uid]);
        allow update, delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // SOS Events
    // ─────────────────────────────────────────────────────────
    match /sosEvents/{sosId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.resource.data.respondedBy.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Live Locations
    // ─────────────────────────────────────────────────────────
    match /liveLocations/{locId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // Blocks
    // ─────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if request.auth != null
        && (resource.data.blockerUid == request.auth.uid
            || resource.data.blockedUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Reports
    // ─────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Disputes
    // ─────────────────────────────────────────────────────────
    match /disputes/{disputeId} {
      allow create: if request.auth != null
        && request.resource.data.filedByUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.filedByUid == request.auth.uid
            || resource.data.againstUid == request.auth.uid);
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Strikes
    // ─────────────────────────────────────────────────────────
    match /strikes/{strikeId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Safety Alerts
    // ─────────────────────────────────────────────────────────
    match /safetyAlerts/{alertId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Payouts
    // ─────────────────────────────────────────────────────────
    match /payouts/{payoutId} {
      allow read: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Subscriptions
    // ─────────────────────────────────────────────────────────
    match /subscriptions/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Boosts
    // ─────────────────────────────────────────────────────────
    match /boosts/{boostId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Pending Boost Orders
    // ─────────────────────────────────────────────────────────
    match /pendingBoostOrders/{orderId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Photographers (public read)
    // ─────────────────────────────────────────────────────────
    match /photographers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Events (public read)
    // ─────────────────────────────────────────────────────────
    match /events/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // App Config
    // ─────────────────────────────────────────────────────────
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Vendors
    // ─────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if (resource.data.status == "approved")
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partnerships
    // ─────────────────────────────────────────────────────────
    match /partnerships/{partnershipId} {
      allow read: if resource.data.status == "active";
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Admin collections
    // ─────────────────────────────────────────────────────────
    match /adminAlerts/{alertId} {
      allow read, write: if false;
    }
    match /partnershipInvoices/{invoiceId} {
      allow read, write: if false;
    }
    match /adminUids/{uid} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Device Tokens
    // ─────────────────────────────────────────────────────────
    match /deviceTokens/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────
    // Chats
    // ─────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(fsdb)/documents/chats/$(chatId)).data.participants;
      }

      match /typing/{typingUid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(fsdb)/documents/chats/$(chatId)).data.participants;
        allow write: if request.auth != null
          && request.auth.uid == typingUid
          && request.auth.uid in get(/databases/$(fsdb)/documents/chats/$(chatId)).data.participants;
      }

      match /reads/{readerUid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(fsdb)/documents/chats/$(chatId)).data.participants;
        allow write: if request.auth != null
          && request.auth.uid == readerUid
          && request.auth.uid in get(/databases/$(fsdb)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Score Events
    // ─────────────────────────────────────────────────────────
    match /scoreEvents/{eventId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.participantUids.hasAny([request.auth.uid])
            || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Escrow
    // ─────────────────────────────────────────────────────────
    match /escrow/{escrowId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Ratings
    // ─────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Activity Feed
    // ─────────────────────────────────────────────────────────
    match /activityFeed/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }

  // ─────────────────────────────────────────────────────────
  // Helper functions
  // ─────────────────────────────────────────────────────────
  function getTrust(uid) {
    return get(/databases/$(fsdb)/documents/users/$(uid)).data.trustBalance;
  }
}